#!/bin/bash

# Directory containing the .pdbqt files to be split.
# Example: /mnt/c/Users/User/Desktop/Docking_poses
INPUT="/path/to/pdbqt/files"

# Output directory 
OUTPUT="$INPUT/poses"
mkdir -p "$OUTPUT"

# Loop in .pdbqt files
for file in "$INPUT"/*.pdbqt; do

    # Skip if no matching .pdbqt file exists
    [ -e "$file" ] || continue

    # Get archive name without extension
    base=$(basename "$file" .pdbqt)

    # Create an output directory for each ligand
    mkdir -p "$OUTPUT/$base"

    echo "===================================="
    echo "Converting: $base"

    # Convert all poses into individual PDB files
    obabel "$file" -O "$OUTPUT/$base/pose.pdb" -m

    # Rename poses according to affinity ranking
    contador=1

    for pose in $(find "$OUTPUT/$base" -maxdepth 1 -type f -name 'pose*.pdb' | sort -V); do
        mv "$pose" "$OUTPUT/$base/${base}_pose_${contador}.pdb"
        ((contador++))
    done

    echo "✓ $((contador-1)) poses saved in $OUTPUT/$base"

done

echo "===================================="
echo "Done!"
